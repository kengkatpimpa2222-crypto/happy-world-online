# Happy World Online backend — copy to .env and change values. NEVER commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose default user/password are for local dev only)
DATABASE_URL=postgresql://hwo:hwo_dev_password@localhost:5432/happy_world_dev?schema=public
# Optional. When set, rate-limit counters are shared via Redis.
REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated browser origins allowed by CORS (mobile apps send no Origin)
CORS_ORIGINS=http://localhost:3000
# Set true only when running behind a trusted reverse proxy / load balancer
TRUST_PROXY=false
# API docs at /api/docs. Always disabled when NODE_ENV=production.
SWAGGER_ENABLED=true

# disabled | mock | google_play   (mock is refused in production)
BILLING_MODE=mock
GOOGLE_PLAY_PACKAGE_NAME=
# Service-account JSON for Google Play Developer API (keep in a secret manager)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_GUEST_PER_HOUR=10
RATE_LIMIT_AUTH_PER_15_MIN=20
BUSINESS_SALE_COOLDOWN_SECONDS=30
